{
  "name": "fullstack-enquiry-management",
  "version": "1.0.0",
  "description": "Fullstack Enquiry Management System",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:frontend": "cd frontend && npm run dev",
    "dev:backend": "cd backend && npm run dev",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "prepare": "husky install"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "concurrently": "^8.2.2",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "husky": "^8.0.3",
    "lint-staged": "^15.2.0",
    "prettier": "^3.2.5",
    "typescript": "^5.3.3"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix --ext .js,.jsx,.ts,.tsx --ignore-pattern '**/*.config.js' --ignore-pattern '**/vite.config.ts' --ignore-pattern '**/tailwind.config.js' --ignore-pattern '**/postcss.config.js' --ignore-pattern '**/eslint.config.js'",
      "prettier --write"
    ],
    "*.{json,md}": "prettier --write"
  }
}
